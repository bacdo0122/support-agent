# Copy to .env and fill in. .env is git-ignored.

# Personal access token for the BOSS MCP server (needs mcp:task:search and mcp:task:worklog:read)
BOSS_TOKEN=

# BOSS MCP endpoint
BOSS_MCP_URL=https://boss.bss-b2b.solutions/mcp

# How often to poll BOSS, in seconds
BOSS_POLL_SECONDS=120

# Your BOSS email (or user id): a task newly assigned to it pops up in the app
BOSS_ASSIGNEE=bacdv@bsscommerce.com
# How often to look for newly assigned tasks, in seconds
ASSIGNED_POLL_SECONDS=30

# How many days of your own worklog to load
WORKLOG_DAYS=30

# Name shown for this machine's sessions (default: hostname)
MACHINE_NAME=Nhà

# The other machine's Support Office URL (its `tailscale serve` address); comma-separated.
# The page connects to these too, and they may read this server's state from the browser.
PEERS=

# Local server. Keep HOST on 127.0.0.1: hook events contain commands and file paths.
# Reach it from other devices with `tailscale serve`, not by binding 0.0.0.0.
HOST=127.0.0.1
PORT=4317
